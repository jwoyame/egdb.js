# tedious is pinned to 20.0.0 (see resolutions in package.json) because it is
# the version verified against real SQL Server/Postgres containers. Its own
# package.json declares engines.node >=22, but it runs correctly on Node 20
# (confirmed directly); without this, a plain `yarn install` on Node 20 aborts
# during the fetch step even though the resolved package works fine.
ignore-engines true
